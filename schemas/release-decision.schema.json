{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/novel-style-distiller/release-decision.schema.json",
  "title": "Pack release decision",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "book_id",
    "normalized_text_sha256",
    "copyright_report",
    "approved",
    "blockers",
    "generated_artifacts",
    "reviewer",
    "reviewed_at"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "book_id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "normalized_text_sha256": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"},
    "copyright_report": {"const": "COPYRIGHT_REPORT.md"},
    "approved": {"const": true},
    "blockers": {"type": "array", "maxItems": 0},
    "generated_artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "overlap_result_path", "passed"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "overlap_result_path": {"type": "string", "minLength": 1},
          "passed": {"const": true}
        }
      }
    },
    "reviewer": {"type": "string", "minLength": 1},
    "reviewed_at": {"type": "string", "minLength": 1}
  }
}

