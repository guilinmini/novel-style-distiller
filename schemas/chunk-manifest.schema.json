{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/novel-style-distiller/chunk-manifest.schema.json",
  "title": "Novel chunk manifest",
  "type": "object",
  "required": ["schema_version", "book_id", "source_sha256", "locator_scheme", "holdout_policy", "chunks"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "book_id": {"type": "string"},
    "source_sha256": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"},
    "locator_scheme": {"type": "string"},
    "holdout_policy": {
      "type": "object",
      "required": ["target_ratio", "stratified_by", "frozen_before_extraction"],
      "properties": {
        "target_ratio": {"type": "number", "minimum": 0, "maximum": 0.5},
        "stratified_by": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "frozen_before_extraction": {"const": true}
      }
    },
    "chunks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["chunk_id", "start_locator", "end_locator", "structural_region", "text_modes", "sha256", "holdout", "extractor_status"],
        "properties": {
          "chunk_id": {"type": "string", "minLength": 1},
          "start_locator": {"type": "string", "minLength": 1},
          "end_locator": {"type": "string", "minLength": 1},
          "structural_region": {"enum": ["opening", "middle", "ending", "mixed"]},
          "text_modes": {"type": "array", "items": {"type": "string"}},
          "sha256": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"},
          "previous_chunk": {"type": ["string", "null"]},
          "next_chunk": {"type": ["string", "null"]},
          "overlap_locators": {"type": "array", "items": {"type": "string"}},
          "holdout": {"type": "boolean"},
          "extractor_status": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "plot-architecture",
              "character-arcs",
              "narration-information",
              "scene-pacing",
              "prose-style",
              "voice-tone-dialogue"
            ],
            "properties": {
              "plot-architecture": {"enum": ["pending", "completed", "failed"]},
              "character-arcs": {"enum": ["pending", "completed", "failed"]},
              "narration-information": {"enum": ["pending", "completed", "failed"]},
              "scene-pacing": {"enum": ["pending", "completed", "failed"]},
              "prose-style": {"enum": ["pending", "completed", "failed", "withheld"]},
              "voice-tone-dialogue": {"enum": ["pending", "completed", "failed", "withheld"]}
            }
          }
        }
      }
    }
  }
}
