{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/novel-style-distiller/evidence-index.schema.json",
  "title": "Installed skill evidence index",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "skill", "source_sha256", "records"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "skill": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "source_sha256": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"},
    "records": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["evidence_id", "locator", "chunk_id", "structural_region", "relation", "role", "paraphrase", "excerpt_hash", "holdout"],
        "properties": {
          "evidence_id": {"type": "string"},
          "locator": {"type": "string", "minLength": 1},
          "chunk_id": {"type": "string", "minLength": 1},
          "structural_region": {"enum": ["opening", "middle", "ending", "mixed"]},
          "relation": {"enum": ["supports", "qualifies", "contradicts"]},
          "role": {"type": "string", "minLength": 1},
          "paraphrase": {"type": "string", "minLength": 1, "maxLength": 300},
          "excerpt_hash": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"},
          "holdout": {"type": "boolean"}
        }
      }
    }
  }
}

