{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/novel-style-distiller/source-manifest.schema.json",
  "title": "Novel source manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "book_id",
    "title",
    "author",
    "edition",
    "original_language",
    "text_language",
    "source_path",
    "source_sha256",
    "source_format",
    "normalized_text_path",
    "normalized_text_sha256",
    "normalized_text_format",
    "completeness",
    "text_quality",
    "rights",
    "analysis_scope",
    "created_at"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "book_id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "title": {"type": "string", "minLength": 1},
    "author": {"type": "string", "minLength": 1},
    "edition": {"type": "string", "minLength": 1},
    "publication_year": {"type": ["string", "integer", "null"]},
    "original_language": {"type": "string", "minLength": 1},
    "text_language": {"type": "string", "minLength": 1},
    "translator": {"type": ["string", "null"]},
    "source_path": {"type": "string", "minLength": 1},
    "source_sha256": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"},
    "source_format": {"enum": ["txt", "md", "epub", "pdf", "other"]},
    "normalized_text_path": {"type": "string", "minLength": 1},
    "normalized_text_sha256": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"},
    "normalized_text_format": {"enum": ["txt", "md"]},
    "completeness": {"enum": ["complete", "partial", "unknown"]},
    "missing_ranges": {"type": "array", "items": {"type": "string"}},
    "text_quality": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "known_issues", "locator_reliability"],
      "properties": {
        "status": {"enum": ["clean", "ocr-reviewed", "ocr-unreviewed", "damaged"]},
        "known_issues": {"type": "array", "items": {"type": "string"}},
        "locator_reliability": {"enum": ["high", "medium", "low"]}
      }
    },
    "rights": {
      "type": "object",
      "additionalProperties": false,
      "required": ["user_confirmed_lawful_access", "redistribution_permission", "notes"],
      "properties": {
        "user_confirmed_lawful_access": {"type": "boolean"},
        "redistribution_permission": {"enum": ["yes", "no", "unknown"]},
        "notes": {"type": "string"}
      }
    },
    "analysis_scope": {"const": "this work and edition only"},
    "created_at": {"type": "string", "minLength": 1}
  }
}
