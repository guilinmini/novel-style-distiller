{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/novel-style-distiller/overlap-result.schema.json",
  "title": "Per-artifact source-overlap result",
  "type": "object",
  "additionalProperties": false,
  "required": ["passed", "quality_gate_only", "source", "source_sha256", "artifacts", "excluded_terms", "thresholds", "notice"],
  "properties": {
    "passed": {"const": true},
    "quality_gate_only": {"const": true},
    "source": {"type": "string", "minLength": 1},
    "source_sha256": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"},
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256", "passed", "continuous_overlap", "shingles", "failures"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"},
          "passed": {"const": true},
          "continuous_overlap": {
            "type": "object",
            "additionalProperties": false,
            "required": ["cjk_characters", "cjk_preview", "unicode_words", "word_preview", "normalized_alphanumeric", "normalized_preview"],
            "properties": {
              "cjk_characters": {"type": "integer", "minimum": 0, "maximum": 17},
              "cjk_preview": {"type": "string"},
              "unicode_words": {"type": "integer", "minimum": 0, "maximum": 9},
              "word_preview": {"type": "string"},
              "normalized_alphanumeric": {"type": "integer", "minimum": 0, "maximum": 35},
              "normalized_preview": {"type": "string"}
            }
          },
          "shingles": {
            "type": "object",
            "additionalProperties": false,
            "required": ["cjk_10", "unicode_words_5", "normalized_characters_16"],
            "properties": {
              "cjk_10": {"$ref": "#/$defs/shingle"},
              "unicode_words_5": {"$ref": "#/$defs/shingle"},
              "normalized_characters_16": {"$ref": "#/$defs/shingle"}
            }
          },
          "failures": {"type": "array", "maxItems": 0}
        }
      }
    },
    "excluded_terms": {"type": "array", "maxItems": 0, "items": {"type": "string"}},
    "thresholds": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_cjk_run", "max_word_run", "max_unicode_run", "max_shingle_ratio"],
      "properties": {
        "max_cjk_run": {"type": "integer", "minimum": 0, "maximum": 17},
        "max_word_run": {"type": "integer", "minimum": 0, "maximum": 9},
        "max_unicode_run": {"type": "integer", "minimum": 0, "maximum": 35},
        "max_shingle_ratio": {"type": "number", "minimum": 0, "maximum": 0.01}
      }
    },
    "notice": {"type": "string", "minLength": 1}
  },
  "$defs": {
    "shingle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ratio", "matched", "total"],
      "properties": {
        "ratio": {"type": "number", "minimum": 0, "exclusiveMaximum": 0.01},
        "matched": {"type": "integer", "minimum": 0},
        "total": {"type": "integer", "minimum": 0}
      }
    }
  }
}
