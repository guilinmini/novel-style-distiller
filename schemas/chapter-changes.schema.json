{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/guilinmini/novel-style-distiller/main/schemas/chapter-changes.schema.json",
  "title": "Accepted chapter changes and fact snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project_id",
    "chapter_id",
    "status",
    "accepted_at",
    "source",
    "style",
    "fact_snapshot",
    "changes",
    "quality_gates",
    "handoff"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "project_id": {"$ref": "#/$defs/stableId"},
    "chapter_id": {"$ref": "#/$defs/stableId"},
    "status": {"const": "ACCEPTED"},
    "accepted_at": {"type": "string", "minLength": 1},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["chapter_file", "chapter_record"],
      "properties": {
        "chapter_file": {"type": "string", "minLength": 1},
        "chapter_record": {"type": "string", "minLength": 1}
      }
    },
    "style": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pack_id", "version", "contract_hash"],
      "properties": {
        "pack_id": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "contract_hash": {"type": "string", "minLength": 1}
      }
    },
    "fact_snapshot": {"$ref": "#/$defs/factSnapshot"},
    "changes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/change"}
    },
    "quality_gates": {
      "type": "object",
      "additionalProperties": false,
      "required": ["task", "continuity", "pov_and_knowledge", "style", "serial_reward", "natural_prose", "source_isolation"],
      "properties": {
        "task": {"const": true},
        "continuity": {"const": true},
        "pov_and_knowledge": {"const": true},
        "style": {"const": true},
        "serial_reward": {"const": true},
        "natural_prose": {"const": true},
        "source_isolation": {"const": true}
      }
    },
    "handoff": {
      "type": "object",
      "additionalProperties": false,
      "required": ["next_chapter", "immediate_pressure", "open_obligations"],
      "properties": {
        "next_chapter": {"type": "string", "minLength": 1},
        "immediate_pressure": {"type": "string"},
        "open_obligations": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      }
    }
  },
  "$defs": {
    "stableId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9-]*$"
    },
    "stateRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "state", "evidence"],
      "properties": {
        "id": {"$ref": "#/$defs/stableId"},
        "state": {"type": "string"},
        "evidence": {"type": "string"}
      }
    },
    "factSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "story_time",
        "locations",
        "pov",
        "characters",
        "relationships",
        "knowledge",
        "reader_knowledge",
        "objects",
        "resources",
        "conditions",
        "world_rules",
        "factions",
        "threads",
        "deadlines",
        "immediate_pressure"
      ],
      "properties": {
        "story_time": {"type": "string"},
        "locations": {"type": "array", "items": {"$ref": "#/$defs/stateRef"}},
        "pov": {"$ref": "#/$defs/stateRef"},
        "characters": {"type": "array", "items": {"$ref": "#/$defs/stateRef"}},
        "relationships": {"type": "array", "items": {"$ref": "#/$defs/stateRef"}},
        "knowledge": {"type": "array", "items": {"$ref": "#/$defs/stateRef"}},
        "reader_knowledge": {"type": "array", "items": {"$ref": "#/$defs/stateRef"}},
        "objects": {"type": "array", "items": {"$ref": "#/$defs/stateRef"}},
        "resources": {"type": "array", "items": {"$ref": "#/$defs/stateRef"}},
        "conditions": {"type": "array", "items": {"$ref": "#/$defs/stateRef"}},
        "world_rules": {"type": "array", "items": {"$ref": "#/$defs/stateRef"}},
        "factions": {"type": "array", "items": {"$ref": "#/$defs/stateRef"}},
        "threads": {"type": "array", "items": {"$ref": "#/$defs/stateRef"}},
        "deadlines": {"type": "array", "items": {"$ref": "#/$defs/stateRef"}},
        "immediate_pressure": {"type": "string"}
      }
    },
    "change": {
      "type": "object",
      "additionalProperties": false,
      "required": ["change_id", "type", "subject_id", "before", "after", "cause", "evidence", "updates"],
      "properties": {
        "change_id": {"$ref": "#/$defs/stableId"},
        "type": {
          "enum": [
            "plot",
            "character",
            "relationship",
            "knowledge",
            "location",
            "object",
            "resource",
            "condition",
            "timeline",
            "thread",
            "world-rule",
            "reader-promise"
          ]
        },
        "subject_id": {"$ref": "#/$defs/stableId"},
        "before": {"$ref": "#/$defs/value"},
        "after": {"$ref": "#/$defs/value"},
        "cause": {"type": "string", "minLength": 1},
        "evidence": {"type": "string", "minLength": 1},
        "updates": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "value": {
      "type": ["string", "number", "boolean", "object", "array", "null"]
    }
  }
}
