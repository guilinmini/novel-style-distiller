{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/novel-style-distiller/evidence.schema.json",
  "title": "Evidence record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "book_id",
    "source_sha256",
    "locator",
    "chunk_id",
    "structural_region",
    "text_mode",
    "relation",
    "role",
    "excerpt_hash",
    "holdout"
  ],
  "properties": {
    "id": {"type": "string", "pattern": "^ev-[a-z0-9-]+$"},
    "book_id": {"type": "string"},
    "source_sha256": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"},
    "locator": {"type": "string", "minLength": 1},
    "chunk_id": {"type": "string", "minLength": 1},
    "structural_region": {"enum": ["opening", "middle", "ending", "mixed"]},
    "text_mode": {"enum": ["narration", "dialogue", "action", "description", "reflection", "mixed"]},
    "relation": {"enum": ["supports", "qualifies", "contradicts"]},
    "role": {"type": "string", "minLength": 1},
    "verification_excerpt": {"type": "string", "maxLength": 240},
    "excerpt_hash": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"},
    "holdout": {"type": "boolean"},
    "notes": {"type": "string"}
  }
}
