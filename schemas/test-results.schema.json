{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/novel-style-distiller/test-results.schema.json",
  "title": "Distilled skill test results",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "skill",
    "kind",
    "method",
    "minimum_runs_per_case",
    "case_results",
    "metrics",
    "gates",
    "hard_failures",
    "passed",
    "evaluated_at"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "skill": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "kind": {"enum": ["source-profile", "transferable-technique"]},
    "method": {"enum": ["independent-blind-agent", "main-agent-fallback"]},
    "minimum_runs_per_case": {"type": "integer", "minimum": 3},
    "case_results": {
      "type": "array",
      "minItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["case_id", "runs", "passed", "median_score", "hard_failures", "notes"],
        "properties": {
          "case_id": {"type": "string", "minLength": 1},
          "runs": {"type": "integer", "minimum": 3},
          "passed": {"type": "boolean"},
          "median_score": {"type": "number", "minimum": 0, "maximum": 1},
          "hard_failures": {"type": "array", "items": {"type": "string"}},
          "notes": {"type": "string"}
        }
      }
    },
    "metrics": {
      "type": "object",
      "required": ["route_precision", "route_recall", "top1_accuracy", "transfer_success", "source_fidelity_pass_rate", "scope_boundary_pass_rate"],
      "properties": {
        "route_precision": {"type": "number", "minimum": 0, "maximum": 1},
        "route_recall": {"type": "number", "minimum": 0, "maximum": 1},
        "top1_accuracy": {"type": "number", "minimum": 0, "maximum": 1},
        "transfer_success": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "source_fidelity_pass_rate": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "scope_boundary_pass_rate": {"type": ["number", "null"], "minimum": 0, "maximum": 1}
      }
    },
    "gates": {
      "type": "object",
      "required": ["all_decoys_passed", "all_sibling_confusion_passed", "all_originality_cases_passed", "all_source_fidelity_cases_passed", "all_scope_boundary_cases_passed"],
      "properties": {
        "all_decoys_passed": {"type": "boolean"},
        "all_sibling_confusion_passed": {"type": "boolean"},
        "all_originality_cases_passed": {"type": ["boolean", "null"]},
        "all_source_fidelity_cases_passed": {"type": ["boolean", "null"]},
        "all_scope_boundary_cases_passed": {"type": ["boolean", "null"]}
      }
    },
    "hard_failures": {"type": "array", "maxItems": 0},
    "passed": {"const": true},
    "evaluated_at": {"type": "string", "minLength": 1}
  }
}

