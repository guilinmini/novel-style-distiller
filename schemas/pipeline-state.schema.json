{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/novel-style-distiller/pipeline-state.schema.json",
  "title": "Distillation pipeline state",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "book_id",
    "source_sha256",
    "status",
    "current_stage",
    "completed_artifacts",
    "coverage",
    "candidates",
    "skills",
    "user_confirmations",
    "next_action",
    "updated_at"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "book_id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "source_sha256": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"},
    "status": {"enum": ["in_progress", "blocked", "complete"]},
    "current_stage": {"enum": ["intake", "whole-novel-model", "extraction", "validation", "skill-build", "evaluation", "delivery"]},
    "completed_artifacts": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["non_holdout_chunks", "completed_chunk_extractor_pairs", "required_chunk_extractor_pairs", "failed_pairs"],
      "properties": {
        "non_holdout_chunks": {"type": "integer", "minimum": 0},
        "completed_chunk_extractor_pairs": {"type": "integer", "minimum": 0},
        "required_chunk_extractor_pairs": {"type": "integer", "minimum": 0},
        "failed_pairs": {"type": "array", "items": {"type": "string"}}
      }
    },
    "candidates": {
      "type": "object",
      "additionalProperties": false,
      "required": ["extracted", "verified", "rejected"],
      "properties": {
        "extracted": {"type": "integer", "minimum": 0},
        "verified": {"type": "integer", "minimum": 0},
        "rejected": {"type": "integer", "minimum": 0}
      }
    },
    "skills": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "kind", "status"],
        "properties": {
          "name": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
          "kind": {"enum": ["source-profile", "transferable-technique"]},
          "status": {"enum": ["pending", "passed", "failed"]}
        }
      }
    },
    "user_confirmations": {"type": "array", "items": {"type": "object"}},
    "next_action": {"type": "string"},
    "updated_at": {"type": "string", "minLength": 1}
  }
}
